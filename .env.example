# Discord
DISCORD_TOKEN=
DISCORD_CLIENT_ID=
# Optional: register slash commands to a single guild for instant updates during development.
# Leave blank to register commands globally (can take up to 1 hour to propagate).
DISCORD_GUILD_ID=
# Channel used for the chat relay (see /mc-relay). Leave blank to disable relay entirely.
DISCORD_CHANNEL_ID=
# Comma-separated Discord user IDs allowed to run sensitive commands (connect/disconnect/say/relay).
# If left blank, anyone with the "Manage Server" permission is treated as an admin.
ADMIN_USER_IDS=

# Minecraft
MC_HOST=donutsmp.net
MC_PORT=25565
# The premium Microsoft account username/email that will log in.
MC_USERNAME=
# Leave blank to let mineflayer auto-detect the server's protocol version.
MC_VERSION=
# Automatically reconnect after an unexpected disconnect (not after a manual /mc-disconnect).
AUTO_RECONNECT=true
# The in-game command /mc-autosell sends to sell your whole inventory in one go.
MC_SELL_COMMAND=/sell all
# Default seconds between sells when /mc-autosell start is run without an interval option.
MC_AUTOSELL_INTERVAL_SECONDS=300
